VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only local development option. Use a path outside this repository.
# Do not prefix this variable with VITE_.
FIREBASE_SERVICE_ACCOUNT_FILE=

# Keep administrator authorization in Firebase Auth custom claims or a trusted backend.
# Do not store admin credentials in the frontend or client environment variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Truehost mailbox SMTP settings. Keep these server-only (never use a VITE_ prefix).
# Find the hostname, port, and encryption mode in the mailbox's "Connect Devices"
# or email-client configuration page in Truehost. Use the full mailbox address as SMTP_USER.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
