rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true);
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == "member"
        && request.resource.data.termsAccepted == true;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fullName",
          "phone",
          "country",
          "bitcoinWallet",
          "bnbWallet",
          "ethereumWallet",
          "litecoinWallet"
        ]);
      allow delete: if request.auth != null && request.auth.token.admin == true;

      match /notifications/{notificationId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.token.admin == true);
        allow write: if false;
      }

      match /transactions/{transactionId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.token.admin == true);
        allow write: if false;
      }

      match /investments/{investmentId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.token.admin == true);
        allow write: if false;
      }

      match /referralRewards/{rewardId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.token.admin == true);
        allow write: if false;
      }

      match /deposits/{depositId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.token.admin == true);
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == "pending";
        allow update, delete: if false;
      }

      match /withdrawals/{withdrawalId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.token.admin == true);
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == "pending";
        allow update, delete: if false;
      }

      match /supportTickets/{ticketId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.token.admin == true);
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == "open";
        allow update, delete: if false;
      }
    }

    // Login by username requires a public lookup before Firebase Auth signs in.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /packages/{packageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /audit/{auditId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    match /adminActions/{actionId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // Ledger entries and audit records are append-only server records. The
    // Admin SDK is the only writer; clients must never manufacture balances.
    match /ledger/{entryId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }
  }
}
